# Optional. Without it the WalletConnect connector is not registered and only
# browser-injected wallets are offered. Get one at https://dashboard.reown.com
VITE_WC_PROJECT_ID=

# Optional. Without it no Swap entry appears in the modal at all.
# Get one from https://docs.dodoex.io/en/developer/developers-portal
VITE_DODO_API_KEY=

# Optional, and only applied when BOTH are set: DODO ignores one without the
# other, which would quietly produce a fee-free swap.
VITE_SWAP_FEE_RECIPIENT=
# Whole number, passed straight through as DODO's `fee`. DODO does not document
# what it is denominated in — confirm before relying on it.
VITE_SWAP_FEE_RATE=

# Optional. `dodo` drops the merged token lists and lets the widget fall back to
# the 66 tokens it bundles (10 chains, no Base/Linea/Scroll/Mantle/zkSync).
# Anything else, or unset, uses the merged lists.
VITE_SWAP_TOKEN_LIST=
