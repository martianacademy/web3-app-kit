{
  "name": "web3-app-kit",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source wallet connection SDK for EVM dApps \u2014 headless core, framework-agnostic modal, React bindings.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache",
    "example": "pnpm --filter @web3-app-kit/example-vite-react dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "happy-dom": "^15.11.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
