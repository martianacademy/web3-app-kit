{
  "name": "@web3-app-kit/react",
  "version": "0.1.0",
  "description": "React hooks and components for web3-app-kit \u2014 provider, useAccount, ConnectButton.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@web3-app-kit/chains": "workspace:*",
    "@web3-app-kit/core": "workspace:*",
    "@web3-app-kit/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "react": "^18.3.1",
    "viem": "^2.21.0"
  },
  "keywords": [
    "web3",
    "react",
    "hooks",
    "wallet",
    "ethereum",
    "viem"
  ]
}
