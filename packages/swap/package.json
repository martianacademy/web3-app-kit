{
  "name": "@web3-app-kit/swap",
  "version": "0.1.0",
  "description": "Multichain token swaps for web3-app-kit, routed through DODO's SmartTrade API.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@web3-app-kit/core": "workspace:*"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "viem": "^2.21.0"
  },
  "keywords": [
    "web3",
    "swap",
    "dodo",
    "evm",
    "defi",
    "aggregator"
  ]
}
